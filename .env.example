# Definitely One (Done) Desktop Application Environment Configuration
# Default behavior:
# - In local dev (npm run dev): uses local auth services (http://localhost:5174 and http://localhost:8081)
# - In production builds: uses canonical production services (https://accounts.definitely.live and https://api.accounts.definitely.live)

# Set to true if you want to test against production Accounts SSO while running local dev server
VITE_USE_PROD_AUTH=false

# Override Identity UI URL (default: http://localhost:5174 in dev, https://accounts.definitely.live in prod)
# VITE_ACCOUNTS_URL=https://accounts.definitely.live

# Override Identity API URL (default: http://localhost:8081 in dev, https://api.accounts.definitely.live in prod)
# VITE_AUTH_API_URL=https://api.accounts.definitely.live

# Native Custom Scheme Callback URI
VITE_REDIRECT_URI=done://auth/callback
